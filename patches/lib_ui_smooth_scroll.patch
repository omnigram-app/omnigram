+			const auto currentPos = _smoothWheelAnimation.animating()
+				? _smoothWheelTarget
+				: float64(_state.visibleFrom);
+			_smoothWheelStart = float64(_state.visibleFrom);
+			_smoothWheelTarget = currentPos + delta;
+			_smoothWheelAnimation.start(
