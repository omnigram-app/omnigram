+					const auto progress = _smoothWheelAnimation.value(1.);
+					// System spring / cubic-bezier(0.23, 1.0, 0.32, 1.0) decelerating ease:
+					// P(t) = 1 - (1 - t)^3 for buttery smooth 120fps kinetic decay
+					const auto inv = 1. - progress;
+					const auto ease = 1. - (inv * inv * inv);
+					const auto next = int(base::SafeRound(
+						_smoothWheelStart + (_smoothWheelTarget - _smoothWheelStart) * ease));
+					tryScrollTo(next);
+				},
+				0.,
+				1.,
+				220); // 220ms smooth kinetic glide duration
 			_movement = Movement::None;
 		} else if (!_overscrollReturnAnimation.animating()) {
 			overscrollReturn();
